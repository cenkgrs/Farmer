  m_Script: {fileID: 11500000, guid: 53d595b5f44f4c93ac3bb5f0fd29b638, type: 3}
  m_Name: variety
  m_EditorClassIdentifier: 
  id: variety
  title: "Çeşit Bereket Getirir"
  description: "Hüseyin’e 3 havuç ve 3 domates teslim et."
  requiredItems:
  - itemId: crop:carrot
    displayName: "Havuç"
    count: 3
  - itemId: crop:tomato
    displayName: "Domates"
    count: 3
  rewardMoney: 120
  rewardItems: []
  offer:
  - player: 0
    text: "Turplar çok beğenildi. Şimdi tezgâhı renklendirelim: üç havuç ve üç domates lazım."
  - player: 1
    text: "Karşılığında ne vereceksin?"
  - player: 0
    text: "Bu sipariş için 120 para ayırdım."
  accepted:
  - player: 0
    text: "Anlaştık! Hazır olduğunda yine uğra."
  - player: 1
    text: "Tamam, siparişi hazırlayacağım."
  inProgress:
  - player: 0
    text: "Sipariş henüz tamamlanmamış. Hazırlayınca tekrar konuşalım."
  readyToDeliver:
  - player: 0
    text: "İstediklerim çantanda görünüyor. Şimdi teslim etmek ister misin?"
  completed:
  - player: 0
    text: "Hepsi tamam. Çok teşekkürler, söz verdiğim ödül senin!"
  - player: 1
    text: "Rica ederim. Görüşürüz!"
