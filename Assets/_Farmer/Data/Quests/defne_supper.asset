  id: defne_supper
  title: "Akşam Sofrası"
  description: "Ocakta 2 pişmiş et hazırla ve Defne’ye getir."
  requiredItems:
  - itemId: hunt:cooked_meat
    displayName: "Pişmiş et"
    count: 2
  rewardMoney: 60
  rewardItems:
  - itemId: wood
    displayName: "Odun"
    count: 3
  offer:
  - player: 0
    text: "Bu akşam sofraya iki porsiyon pişmiş et lazım. Ocağın hazırsa yardımcı olur musun?"
  - player: 1
    text: "Malzemeleri hazırlayıp pişirebilirim."
  - player: 0
    text: "İki pişmiş eti getir; sana 60 para ve üç odun vereyim."
  accepted:
  - player: 0
    text: "Anlaştık! Hazır olduğunda yine uğra."
  - player: 1
    text: "Tamam, siparişi hazırlayacağım."
  inProgress:
  - player: 0
    text: "Sipariş henüz tamamlanmamış. Hazırlayınca tekrar konuşalım."
  readyToDeliver:
  - player: 0
    text: "İstediklerim çantanda görünüyor. Şimdi teslim etmek ister misin?"
  completed:
  - player: 0
    text: "Hepsi tamam. Çok teşekkürler, söz verdiğim ödül senin!"
  - player: 1
    text: "Rica ederim. Görüşürüz!"
